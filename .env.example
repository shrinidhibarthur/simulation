# PostgreSQL
POSTGRES_USER=albertsons
POSTGRES_PASSWORD=changeme
POSTGRES_DB=simulations
DATABASE_URL=postgresql+asyncpg://albertsons:changeme@postgres:5432/simulations

# Sync URL for Alembic & Celery (no asyncpg)
SYNC_DATABASE_URL=postgresql://albertsons:changeme@postgres:5432/simulations

# Redis
REDIS_PASSWORD=changeme
REDIS_URL=redis://:changeme@redis:6379/0

# Celery (separate DBs for broker vs result backend)
CELERY_BROKER_URL=redis://:changeme@redis:6379/0
CELERY_RESULT_BACKEND=redis://:changeme@redis:6379/1

# Google Gemini
GOOGLE_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# App
SECRET_KEY=change_me_32_chars_minimum_please_update
ENVIRONMENT=development
LOG_LEVEL=INFO

# Next.js public vars (included in browser bundle)
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
